{
  "name": "Ace AI Chatbot Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ace-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "id": "webhook-trigger",
      "name": "Webhook Trigger"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are \"Aace AI\", a highly warm, friendly, professional, and human-like AI assistant for \"Ace Automation\". Speak in a natural mixture of Hinglish and English. Help customers understand our automation services (Web Development, WhatsApp Automation, AI Voice Agents, CRM automation) and encourage them to book a consultation."
        }
      },
      "type": "n8n-nodes-base.advancedAgent",
      "typeVersion": 1,
      "position": [
        220,
        240
      ],
      "id": "ai-agent",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "gemini-2.5-flash",
        "options": {}
      },
      "type": "n8n-nodes-base.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        160,
        420
      ],
      "id": "gemini-model",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googleAnswersApi": {
          "id": "your-gemini-credentials-id",
          "name": "Google Gemini API Account"
        }
      }
    },
    {
      "parameters": {
        "sessionId": "={{ $json.body.sessionId }}"
      },
      "type": "n8n-nodes-base.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        300,
        420
      ],
      "id": "chat-memory",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"text\": \"{{ $json.output }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        240
      ],
      "id": "respond-to-webhook",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
